* text=auto
*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf
.env* text eol=lf

# The desktop app's husky hook is a shell script run by sh, and .nvmrc is read line-exact: a CRLF
# checkout breaks both (sh would run "yarn lint-staged" followed by a carriage return).
# Extensionless, so no rule above reaches them.
desktop/.husky/* text eol=lf
.nvmrc text eol=lf
