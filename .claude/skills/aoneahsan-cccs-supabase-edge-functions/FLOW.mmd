%% Supabase Edge Functions — full flow
%% Pure Mermaid. No Markdown fence.

flowchart TD
    trigger([Logic that cannot live in the client]) --> where{Can the DATABASE do it?<br/>a view · a generated column<br/>· an RPC · full-text search}

    where -->|yes| db[Do it there. Cheaper, transactional,<br/>and it does not spend an invocation]
    where -->|no| who{Who should it run as?}

    who -->|"the calling user — the DEFAULT"| user["userClient(req):<br/>forward the Authorization header<br/>so RLS still applies"]
    who -->|"no caller, or cross-user work"| admin[adminClient — service role.<br/>State the reason.<br/>The FUNCTION is now the security boundary:<br/>validate the caller yourself]

    user --> cors
    admin --> cors

    cors{Does it handle the<br/>OPTIONS preflight?}
    cors -->|no| addcors[Add it. Without it the function<br/>works in curl and fails in the browser]
    addcors --> cors

    cors -->|yes| secrets{Any secrets?}
    secrets -->|yes| env["supabase secrets set + Deno.env.<br/>NEVER a VITE_ prefix — that ships<br/>the value in the bundle"]
    secrets -->|no| sched

    env --> sched{Is it scheduled?}
    sched -->|yes| idem{Is the work IDEMPOTENT?}
    sched -->|no| test

    idem -->|no| fix[🔴 Make it idempotent — upsert on a<br/>natural key, or a processed_at guard.<br/>A cron job WILL run twice]
    fix --> idem
    idem -->|yes| cron[cron.schedule + net.http_post]
    cron --> test

    test[supabase functions serve --env-file<br/>then deploy and call it for real]

    test --> verify{As a NON-ADMIN caller,<br/>does RLS still bite?}
    verify -->|"reads/writes nothing"| jwt[The Authorization header is missing —<br/>the client is anonymous.<br/>Reads as a policy bug; it is not]
    jwt --> user
    verify -->|"correct rows only"| budget{Called transactionally,<br/>not per keystroke or per render?}
    budget -->|no| batch[Batch or debounce.<br/>500k invocations/month]
    batch --> budget
    budget -->|yes| done([Done: runs as the right identity,<br/>CORS-safe, idempotent, within budget])

    classDef gate fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#ecfdf5,stroke:#059669,color:#064e3b
    class where,who,cors,secrets,sched,idem,verify,budget gate
    class trigger,done terminal
