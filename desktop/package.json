{
  "name": "windowsweep-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "The windowsweep desktop application - a Tauri 2 window over the same PowerShell engine the CLI runs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --logLevel info",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "yarn typecheck && yarn lint && yarn build && yarn test",
    "deps:outdated": "npx -y npm-check-updates",
    "deps:update": "npx -y npm-check-updates -u --reject typescript && yarn install",
    "postinstall": "cd .. && husky desktop/.husky",
    "tauri": "tauri",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.47.0",
    "@sentry/browser": "^11.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-router": "^1.170.39",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "i18next": "^26.4.2",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "~0.31.11",
    "eslint": "~10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "yarn@4.17.1"
}
