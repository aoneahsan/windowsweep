{
  "name": "windowsweep-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "The windowsweep desktop application - a Tauri 2 window over the same PowerShell engine the CLI runs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --logLevel info",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "yarn typecheck && yarn lint && yarn build && yarn test",
    "deps:outdated": "npx -y npm-check-updates",
    "deps:update": "npx -y npm-check-updates -u --reject typescript && yarn install",
    "postinstall": "cd .. && husky desktop/.husky",
    "tauri": "tauri",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.49.2",
    "@hookform/resolvers": "^7.0.5",
    "@sentry/browser": "^11.11.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "d3-array": "^3.2.5",
    "d3-format": "^3.1.3",
    "d3-hierarchy": "^3.1.3",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "d3-time-format": "^4.1.1",
    "driver.js": "1.11.0",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.4.2",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.0.15",
    "strata-storage": "3.1.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "packageManager": "yarn@4.17.1"
}
