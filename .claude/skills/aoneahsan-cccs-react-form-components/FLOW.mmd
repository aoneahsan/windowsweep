%% aoneahsan-cccs-react-form-components — full flow
flowchart TD
    trigger([Adding or reviewing a form field]) --> exists{Does a wrapper for this<br/>input type already exist?}
    exists -->|yes| reuse[Use it. Do not re-wire<br/>label/error/ARIA per field]
    exists -->|no| build[Build one in components/form-fields/<br/>implementing the shared interface]

    build --> contract[Render: label bound by htmlFor,<br/>the control, help text, error]
    contract --> aria[Wire aria-invalid + aria-describedby<br/>+ aria-required]
    aria --> type

    reuse --> type
    type{Which input type?}

    type -->|file / image /<br/>document upload| guide{Is there an explicit<br/>UploadGuide for this field?}
    guide -->|no| derive[DERIVE one from the accept<br/>and size props — no upload field<br/>is ever left unexplained]
    guide -->|yes| popover
    derive --> popover
    popover[Info icon beside the label opens a<br/>POPOVER — not a Tooltip, which cannot<br/>host a link accessibly]
    popover --> content[State BEFORE the pick: purpose,<br/>accepted types, max size, dimensions<br/>+ aspect, a tip, a downloadable example]
    content --> honest{Do the stated limits MATCH<br/>what the field enforces?}
    honest -->|no| fixlimits[Fix one or the other.<br/>Wrong limits are worse than none]
    honest -->|yes| done
    fixlimits --> honest

    type -->|choice: radio,<br/>checkbox, small select| count{How many options?}
    count -->|8 or fewer| cardgroup[RadioCardGroup / CheckboxCardGroup —<br/>icon + title + description]
    count -->|more than 8| listorselect[List or select control]

    type -->|select| rs["react-select v5 via Controller.<br/>Theme it to project tokens —<br/>never ship its default styling"]

    type -->|date| native{Ranges or<br/>multi-month view?}
    native -->|no| nativeinput["input type=date — native mobile<br/>picker for free"]
    native -->|yes| datelib[Use a library, via Controller]

    type -->|rich text| tiptap[RichTextField wrapping tiptap —<br/>see the tiptap skill]

    cardgroup --> done
    listorselect --> done
    rs --> done
    nativeinput --> done
    datelib --> done
    tiptap --> done
    done([Keyboard + screen reader verified])

    classDef gateNode fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#ecfdf5,stroke:#059669,color:#064e3b
    class exists,type,guide,honest,count,native gateNode
    class trigger,done terminal
