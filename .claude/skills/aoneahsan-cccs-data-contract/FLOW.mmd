%% aoneahsan-cccs-data-contract — full flow
flowchart TD
    START([data crosses the client/server boundary]) --> WHICH{"reading data<br/>or sending it?"}

    WHICH -- reading --> SHAPE{"do you need the ROWS<br/>or an ANSWER?"}
    SHAPE -- "an answer: count, total,<br/>series, report" --> AGG[Aggregate SERVER-side:<br/>a query, a DB function,<br/>or a server function]
    AGG --> WIRE[Only the answer crosses the wire]
    SHAPE -- "the rows themselves" --> BOUND{"is the read bounded?<br/>limit + server-side filter/sort"}
    BOUND -- no --> ADDLIMIT["Add the limit, move filter/sort/count<br/>into the query<br/>see rules/data-fetch-budget.md"]
    ADDLIMIT --> BOUND
    BOUND -- yes --> LOCAL{"about to filter, sort<br/>or reduce in the client?"}
    LOCAL -- yes --> OK1{"over an ALREADY-BOUNDED page<br/>or a genuinely local dataset?"}
    OK1 -- no --> ADDLIMIT
    OK1 -- yes --> RENDER([render it])
    LOCAL -- no --> RENDER
    WIRE --> RENDER

    WHICH -- sending --> VALIDATE[Client: validate against the schema]
    VALIDATE --> REQOK{"every REQUIRED field present<br/>and well formed?"}
    REQOK -- no --> TELL[Show the message AT THE FIELD<br/>focus the first invalid one<br/>never send it]
    TELL --> VALIDATE
    REQOK -- yes --> PAYLOAD[Shape the payload]

    PAYLOAD --> BLANK{"an optional field<br/>the user left blank?"}
    BLANK -- yes --> INTENT{"did the user mean<br/>DIDN'T FILL IN, or CLEAR IT?"}
    INTENT -- "didn't fill in" --> OMIT["REMOVE THE KEY<br/>never null, undefined or empty string"]
    INTENT -- "clear it" --> NULLIT[Send an explicit null<br/>a deliberate erase]
    OMIT --> SEND
    NULLIT --> SEND
    BLANK -- no --> SEND

    SEND[Send] --> GATE1{"1. request SHAPE valid?"}
    GATE1 -- no --> R422([422 - before anything else runs])
    GATE1 -- yes --> GATE2{"2. AUTHENTICATED?"}
    GATE2 -- no --> R401([401])
    GATE2 -- yes --> GATE3{"3. AUTHORIZED?<br/>role, permission, tenant, ownership"}
    GATE3 -- no --> R403([403])
    GATE3 -- yes --> GATE4{"4. BUSINESS validity?<br/>does the row exist, is this state legal"}
    GATE4 -- no --> R409([409 or 422 - with a message<br/>the user can act on])
    GATE4 -- yes --> DB[(5. only now: the database)]

    DB --> CONSTRAINT{"did a DB constraint<br/>reject it?"}
    CONSTRAINT -- yes --> MISSING["That is a MISSING step 4.<br/>A constraint is not a validator -<br/>a 500 is not an error message"]
    MISSING --> GATE4
    CONSTRAINT -- no --> DONE([committed])

    classDef gateNode fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#ecfdf5,stroke:#059669,color:#064e3b
    class WHICH,SHAPE,BOUND,LOCAL,OK1,REQOK,BLANK,INTENT,GATE1,GATE2,GATE3,GATE4,CONSTRAINT gateNode
    class START,RENDER,DONE,R401,R403,R409,R422 terminal
