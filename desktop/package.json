    "tauri": "tauri",
    "gen:prepaint": "node scripts/gen-prepaint.mjs",
    "check:prepaint": "node scripts/gen-prepaint.mjs --check",
    "predev": "node scripts/gen-prepaint.mjs",
    "prebuild": "node scripts/gen-prepaint.mjs"
